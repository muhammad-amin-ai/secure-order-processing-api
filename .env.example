# Copy this file to .env and adjust values for your environment.
# Never commit a real .env file.

APP_NAME="Secure Order Processing API"
ENVIRONMENT=development

# SQLite (zero-setup default):
DATABASE_URL=sqlite:///./order_api.db

# PostgreSQL (recommended stack / used by docker-compose.yml):
# DATABASE_URL=postgresql://order_api:order_api_password@localhost:5432/order_api

SECRET_KEY=please-generate-a-long-random-string-and-put-it-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
